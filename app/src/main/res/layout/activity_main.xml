<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#FAFBFC">

    <!-- Top Toolbar / URL Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_toolbar"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🏠"
            android:textSize="18sp"
            android:background="@drawable/bg_button"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4px" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded"
            android:hint="@string/hint_url"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:textColor="#24292E"
            android:layout_marginHorizontal="6dp" />

        <Button
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_button"
            android:text="@string/btn_go"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⚙"
            android:textSize="20sp"
            android:background="@drawable/bg_button"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4px"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Progress Bar for Fast Loading Feedback -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@android:drawable/progress_horizontal" />

    <!-- WebView Container (Fast Browser) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Settings overlay panel -->
        <LinearLayout
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F6F8FA"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#24292E"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_desc"
                android:textSize="15sp"
                android:textColor="#586069"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnOpenSystemSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button"
                android:text="@string/btn_open_system_settings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/service_stopped"
                android:textSize="14sp"
                android:textColor="#0366D6"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnToggleService"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button"
                android:text="@string/btn_toggle_service"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Navigation Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_toolbar"
        android:padding="6dp"
        android:gravity="center"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="@string/btn_back"
            android:textSize="14sp"
            android:background="@drawable/bg_button"
            android:textColor="#FFFFFF"
            android:layout_marginHorizontal="4dp" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="@string/btn_forward"
            android:textSize="14sp"
            android:background="@drawable/bg_button"
            android:textColor="#FFFFFF"
            android:layout_marginHorizontal="4dp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="@string/btn_refresh"
            android:textSize="14sp"
            android:background="@drawable/bg_button"
            android:textColor="#FFFFFF"
            android:layout_marginHorizontal="4dp" />
    </LinearLayout>

</LinearLayout>
